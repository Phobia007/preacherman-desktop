{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/common/artifact-created.schema.json",
  "title": "artifact.created",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "artifact.created"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "task_run",
            "test_run",
            "validation_run"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "artifact_id",
            "artifact_type",
            "name"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "artifact_type": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "mime_type": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
