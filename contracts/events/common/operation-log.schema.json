{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/common/operation-log.schema.json",
  "title": "operation.log",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "operation.log"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "task_run",
            "test_run",
            "validation_run",
            "import_job",
            "export_job",
            "response_run",
            "generation_job"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "level",
            "message"
          ],
          "properties": {
            "level": {
              "enum": [
                "debug",
                "info",
                "warning",
                "error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
