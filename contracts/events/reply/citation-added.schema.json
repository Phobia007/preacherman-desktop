{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/reply/citation-added.schema.json",
  "title": "reply.citation_added",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "reply.citation_added"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "conversation"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "assistant_message_id",
            "citation"
          ],
          "properties": {
            "assistant_message_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "citation": {
              "type": "object",
              "required": [
                "source_id",
                "title"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri-reference"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
