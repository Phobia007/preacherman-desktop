{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/reply/delta.schema.json",
  "title": "reply.delta",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "reply.delta"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "conversation"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "assistant_message_id",
            "delta",
            "content_index"
          ],
          "properties": {
            "assistant_message_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "delta": {
              "type": "string",
              "minLength": 1
            },
            "content_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
