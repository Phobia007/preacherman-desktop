{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/reply/completed.schema.json",
  "title": "reply.completed",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "reply.completed"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "conversation"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "assistant_message_id",
            "finish_reason",
            "usage_summary"
          ],
          "properties": {
            "assistant_message_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "finish_reason": {
              "enum": [
                "stop",
                "length",
                "cancelled"
              ]
            },
            "usage_summary": {
              "type": "object",
              "required": [
                "input_tokens",
                "output_tokens"
              ],
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
