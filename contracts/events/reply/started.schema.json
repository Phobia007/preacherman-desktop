{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/reply/started.schema.json",
  "title": "reply.started",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "reply.started"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "conversation"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "response_run_id",
            "assistant_message_id"
          ],
          "properties": {
            "response_run_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "assistant_message_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
