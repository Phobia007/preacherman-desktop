{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/validation/review-item-created.schema.json",
  "title": "validation.review_item_created",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "validation.review_item_created"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "validation_run"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "review_item_id",
            "category",
            "severity",
            "title"
          ],
          "properties": {
            "review_item_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "blocking"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
