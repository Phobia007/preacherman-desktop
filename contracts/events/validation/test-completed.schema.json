{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/validation/test-completed.schema.json",
  "title": "validation.test_completed",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "validation.test_completed"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "validation_run"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "test_case_id",
            "result",
            "duration_ms"
          ],
          "properties": {
            "test_case_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "result": {
              "enum": [
                "pass",
                "review",
                "fail"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
