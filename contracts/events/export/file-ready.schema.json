{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/export/file-ready.schema.json",
  "title": "export.file_ready",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "export.file_ready"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "export_job"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "download_url",
            "expires_at",
            "checksum"
          ],
          "properties": {
            "download_url": {
              "type": "string",
              "format": "uri-reference"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "checksum": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
