{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/export/file-processed.schema.json",
  "title": "export.file_processed",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "export.file_processed"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "export_job"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "filename",
            "index",
            "total"
          ],
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "index": {
              "type": "integer",
              "minimum": 1
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
