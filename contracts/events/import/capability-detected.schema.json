{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/import/capability-detected.schema.json",
  "title": "import.capability_detected",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "import.capability_detected"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "import_job"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "capability_code",
            "name",
            "confidence"
          ],
          "properties": {
            "capability_code": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
