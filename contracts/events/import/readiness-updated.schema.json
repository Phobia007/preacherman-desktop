{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/import/readiness-updated.schema.json",
  "title": "import.readiness_updated",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "import.readiness_updated"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "import_job"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "score",
            "blocking_count"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "blocking_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
