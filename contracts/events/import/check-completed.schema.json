{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/import/check-completed.schema.json",
  "title": "import.check_completed",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "import.check_completed"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "import_job"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "check_id",
            "result",
            "summary"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "result": {
              "enum": [
                "passed",
                "review",
                "failed"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "review_item_id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
