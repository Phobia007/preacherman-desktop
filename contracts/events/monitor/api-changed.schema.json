{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/monitor/api-changed.schema.json",
  "title": "monitor.api_changed",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "monitor.api_changed"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "state"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "active_count",
            "limit",
            "apis"
          ],
          "properties": {
            "active_count": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 0
            },
            "apis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
