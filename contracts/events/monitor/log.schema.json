{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/events/monitor/log.schema.json",
  "title": "monitor.log",
  "allOf": [
    {
      "$ref": "https://schemas.preacherman.ai/events/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "monitor.log"
        },
        "schema_version": {
          "const": 1
        },
        "resource_type": {
          "enum": [
            "state"
          ]
        },
        "payload": {
          "type": "object",
          "required": [
            "level",
            "code",
            "message",
            "timestamp"
          ],
          "properties": {
            "level": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "schema_version",
        "resource_type",
        "payload"
      ]
    }
  ]
}
