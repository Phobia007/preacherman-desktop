{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/ab/v1/task-envelope.schema.json",
  "title": "A/B Task Envelope",
  "type": "object",
  "required": [
    "protocol_version",
    "task_id",
    "conversation_id",
    "idempotency_key",
    "created_at",
    "created_by",
    "raw_user_input",
    "objective",
    "success_criteria",
    "constraints",
    "allowed_actions",
    "approval_policy"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/protocol_version"
    },
    "task_id": {
      "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/identifier"
    },
    "conversation_id": {
      "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/identifier"
    },
    "idempotency_key": {
      "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/identifier"
    },
    "created_at": {
      "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/timestamp"
    },
    "created_by": {
      "allOf": [
        {
          "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/actor_ref"
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "front_agent"
            }
          }
        }
      ]
    },
    "raw_user_input": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "transcript_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "statement"
        ],
        "properties": {
          "kind": {
            "enum": [
              "must",
              "must_not",
              "preference"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      }
    },
    "allowed_actions": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,127}$"
      }
    },
    "approval_policy": {
      "type": "object",
      "required": [
        "mode",
        "required_for"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "risk_based",
            "always"
          ]
        },
        "required_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "credential_use",
              "destructive_change",
              "external_communication",
              "financial_transaction",
              "publication"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "none"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "required_for": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "context_refs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/logical_ref"
      }
    },
    "prsp_contract_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/logical_ref"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "prsp_contract"
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
