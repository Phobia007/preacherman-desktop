{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.preacherman.ai/ab/v1/capability-manifest.schema.json",
  "title": "A/B Adapter Capability Manifest",
  "type": "object",
  "required": [
    "protocol_version",
    "adapter_id",
    "adapter_version",
    "role",
    "provider",
    "api_family",
    "supported_protocol_versions",
    "input_modalities",
    "output_modalities",
    "features",
    "supported_actions"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/protocol_version"
    },
    "adapter_id": {
      "$ref": "https://schemas.preacherman.ai/ab/v1/common.schema.json#/$defs/identifier"
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "role": {
      "enum": [
        "front_agent",
        "executor_agent"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "api_family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "supported_protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": 1
      },
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "input_modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "audio",
          "image",
          "text",
          "video"
        ]
      }
    },
    "output_modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "audio",
          "image",
          "text",
          "video"
        ]
      }
    },
    "features": {
      "type": "object",
      "required": [
        "async_execution",
        "cancellation",
        "human_approval",
        "resume",
        "steering",
        "streaming",
        "tool_calling"
      ],
      "properties": {
        "async_execution": {
          "type": "boolean"
        },
        "cancellation": {
          "type": "boolean"
        },
        "human_approval": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        },
        "steering": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        },
        "tool_calling": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "supported_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._*-]{1,127}$"
      }
    }
  },
  "additionalProperties": false
}
