{
  "name": "@preacherman/demo-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:service": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:cortana-voice-telemetry": "node --test --test-isolation=none tests/cortana-voice-timing.test.mjs tests/cortana-voice-telemetry-runtime.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "configure:preacherman-execution": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-preacherman-execution-profile.ps1",
    "verify:preacherman-execution": "node scripts/verify-preacherman-execution-fusion.mjs",
    "sync:avatar": "node scripts/sync-local-avatar.mjs",
    "sync:motions": "node scripts/sync-cortana-motion-library.mjs",
    "build:windows-service": "node scripts/build-windows-sidecar.mjs",
    "build:windows": "npm run build:windows-service && tauri build --bundles nsis",
    "tauri": "tauri",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@preacherman/avatar-renderer": "file:../../packages/preacherman-avatar-renderer",
    "@preacherman/presentation-runtime": "file:../../packages/preacherman-presentation-runtime",
    "@preacherman/surface-skin": "file:../../packages/preacherman-surface-skin",
    "@react-three/drei": "9.115.0",
    "@react-three/fiber": "8.18.0",
    "@tauri-apps/api": "2.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.185.1",
    "ws": "^8.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "stats-gl": "2.2.7"
  }
}
