# Never commit real values in .env.local.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Optional anonymous Cortana voice timing telemetry. The token stays server-side.
VITE_POSTHOG_TIMING_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Optional override for generated artifacts. Defaults to ~/.preacherman-demo.
# PREACHERMAN_DATA_DIR=
# Optional comma-separated local preview origins for parallel worktrees.
# PREACHERMAN_PREVIEW_ORIGINS=http://127.0.0.1:1422

# Optional Preacherman Execution complex-task executor. Never expose these tokens to the UI.
PREACHERMAN_EXECUTION_ENABLED=true
PREACHERMAN_EXECUTION_BASE_URL=http://127.0.0.1:19191
PREACHERMAN_EXECUTION_DAG_TOKEN=
PREACHERMAN_EXECUTION_APPROVAL_TOKEN=
PREACHERMAN_EXECUTION_DEFAULT_WORKFLOW_ID=preacherman-complex-task-v1
PREACHERMAN_EXECUTION_WORKFLOW_REVISION=3
PREACHERMAN_EXECUTION_CANONICAL_HASH=bf7783be10cfc62b5e16154d026ef434c6990c387432401f1604c8b23e52c4ee
PREACHERMAN_EXECUTION_PROFILE=
PREACHERMAN_EXECUTION_CONSOLE_URL=http://127.0.0.1:19193
